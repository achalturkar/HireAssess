generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(255)
  slug         String        @unique @db.VarChar(255)
  contactEmail String?       @map("contact_email") @db.VarChar(255)
  contactPhone String?       @map("contact_phone") @db.VarChar(50)
  logoUrl      String?       @map("logo_url") @db.VarChar(500)
  primaryColor String?       @map("primary_color") @db.VarChar(20)
  address      String?
  settings     Json          @default("{}")
  status       CompanyStatus @default(ACTIVE)
  isDeleted    Boolean       @default(false) @map("is_deleted")
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdById  String?       @map("created_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditLogs    AuditLog[]
  clients      Client[]
  roles        Role[]
  users        User[]
  assessments  Assessment[]
  candidates   Candidate[]
  examAttempts ExamAttempt[]

  @@index([status])
  @@index([isDeleted])
  @@index([name])
  @@map("companies")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String?          @map("company_id") @db.Uuid
  name            String           @db.VarChar(100)
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  isCompanyAdmin  Boolean          @default(false) @map("is_company_admin")
  isSuperAdmin    Boolean          @default(false) @map("is_super_admin")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users           User[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(100)
  module          String           @db.VarChar(50)
  action          String           @db.VarChar(50)
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  companyId          String?        @map("company_id") @db.Uuid
  roleId             String         @map("role_id") @db.Uuid
  firstName          String         @map("first_name") @db.VarChar(100)
  lastName           String         @map("last_name") @db.VarChar(100)
  email              String         @unique @db.VarChar(255)
  phone              String?        @db.VarChar(50)
  passwordHash       String         @map("password_hash") @db.VarChar(255)
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  status             UserStatus     @default(ACTIVE)
  isDeleted          Boolean        @default(false) @map("is_deleted")
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?      @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]
  company            Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role               Role           @relation(fields: [roleId], references: [id])

  @@index([companyId])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  jti          String    @unique @db.VarChar(100)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  ipAddress    String?   @map("ip_address") @db.VarChar(50)
  isRevoked    Boolean   @default(false) @map("is_revoked")
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  metadata  Json?
  ipAddress String?  @map("ip_address") @db.VarChar(50)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  company   Company? @relation(fields: [companyId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Client {
  name         String       @db.VarChar(255)
  industry     String?      @db.VarChar(150)
  contactEmail String?      @map("contact_email") @db.VarChar(255)
  contactName  String?      @map("contact_name") @db.VarChar(150)
  contactPhone String?      @map("contact_phone") @db.VarChar(50)
  createdAt    DateTime     @default(now()) @map("created_at")
  logoUrl      String?      @map("logo_url") @db.VarChar(500)
  updatedAt    DateTime     @updatedAt @map("updated_at")
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @db.Uuid
  addressLine1 String?      @map("address_line1")
  addressLine2 String?      @map("address_line2")
  city         String?
  clientCode   String       @unique @map("client_code") @db.VarChar(50)
  country      String?
  createdById  String?      @db.Uuid
  deletedAt    DateTime?
  gstNumber    String?      @map("gst_number") @db.VarChar(30)
  isDeleted    Boolean      @default(false)
  panNumber    String?      @map("pan_number") @db.VarChar(20)
  postalCode   String?      @map("postal_code")
  state        String?
  status       ClientStatus @default(ACTIVE)
  updatedById  String?      @db.Uuid
  website      String?      @db.VarChar(255)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assessments Assessment[]
  candidates  Candidate[]

  @@index([companyId])
  @@index([status])
  @@map("clients")
}

model Candidate {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  assessmentId String @map("assessment_id") @db.Uuid
  clientId     String @map("client_id") @db.Uuid

  firstName String @map("first_name")
  lastName  String @map("last_name")

  email String
  phone String?

  status CandidateStatus @default(INVITED)

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  createdById String? @map("created_by") @db.Uuid
  updatedById String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company    Company    @relation(fields: [companyId], references: [id])
  client     Client     @relation(fields: [clientId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])

  invitations CandidateInvitation[]
  examAttempts ExamAttempt[]

  // A candidate should only appear once per assessment
  @@unique([assessmentId, email])
  @@index([companyId, status])
  @@index([companyId, clientId])
  @@index([companyId, assessmentId])
  @@map("candidate")
}



model CandidateInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  candidateId String           @map("candidate_id") @db.Uuid
  token       String           @unique
  status      InvitationStatus @default(SENT)
  expiresAt   DateTime         @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
  @@index([status])
  @@map("candidate_invitation")
}


model Assessment {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  clientId  String @map("client_id") @db.Uuid

  name String

  level AssessmentLevel

  likertCount       Int @default(0) @map("likert_count")
  sjqCount          Int @default(0) @map("sjq_count")
  forcedChoiceCount Int @default(0) @map("forced_choice_count")

  durationMinutes Int @map("duration_minutes")

  status AssessmentStatus @default(ACTIVE)

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  createdById String? @map("created_by") @db.Uuid
  updatedById String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])

  candidates Candidate[]
  examAttempts ExamAttempt[]

  @@index([companyId, status])
  @@index([companyId, clientId])
  @@map("assessment")
}



model ExamAttempt {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @map("company_id") @db.Uuid
  candidateId  String @map("candidate_id") @db.Uuid
  assessmentId String @map("assessment_id") @db.Uuid

  startedAt   DateTime? @map("started_at")
  submittedAt DateTime? @map("submitted_at")
  expiresAt   DateTime? @map("expires_at")

  status AttemptStatus @default(IN_PROGRESS)

  // Question ids the candidate was shown, grouped by category, e.g.
  //   { "likert": ["lk12","lk55","lk80"], "sjq": ["sj11","sj29"], "forced": ["fc08","fc99"] }
  // Selected exactly once on first start and reused on every resume/refresh,
  // so the candidate is never shown a different question set mid-attempt.
  selectedQuestions Json @map("selected_questions") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company    Company    @relation(fields: [companyId], references: [id])
  candidate  Candidate  @relation(fields: [candidateId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])

  answers CandidateAnswer[]

  result AssessmentResult?

  // One attempt per candidate per assessment — mirrors the existing
  // @@unique([assessmentId, email]) constraint on Candidate itself.
  @@unique([candidateId, assessmentId])
  @@index([companyId, status])
  @@index([candidateId])
  @@index([assessmentId])
  @@map("exam_attempt")
}

model CandidateAnswer {
  id           String @id @default(uuid()) @db.Uuid
  attemptId    String @map("attempt_id") @db.Uuid
  questionId   String @map("question_id")
  questionType String @map("question_type")
  category     String

  // Flexible payload, shape depends on question type, e.g.
  //   { "answer": 5 }        — likert / scale
  //   { "selected": "q3" }   — single choice / forced choice
  answer Json  @db.JsonB
  score  Float?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attempt ExamAttempt @relation(fields: [attemptId], references: [id])

  // One answer per question per attempt — re-submitting the same
  // question (candidate changes their mind) overwrites in place
  // instead of creating a duplicate row.
  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([attemptId, category])
  @@map("candidate_answer")
}

model AssessmentResult {
  id           String @id @default(uuid()) @db.Uuid
  attemptId    String @unique @map("attempt_id") @db.Uuid // one result per attempt
  overallScore Float  @map("overall_score")

  // e.g. { "Leadership": 83, "Communication": 71, "Decision Making": 90,
  //         "Adaptability": 65, "Strategic Thinking": 78 }
  traitScores Json @map("trait_scores") @db.JsonB

  // Freeform narrative/report payload — bands, interpretations,
  // recommendations, whatever your report template needs.
  report Json @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")

  attempt ExamAttempt @relation(fields: [attemptId], references: [id])

  @@map("assessment_result")
}



model Report {

  id String @id @default(uuid()) @db.Uuid

  companyId String @db.Uuid

  assessmentId String @db.Uuid

  candidateId String @db.Uuid

  attemptId String @unique @db.Uuid

  overallScore Float

  competencyScores Json

  strengths Json

  developmentAreas Json

  recommendations Json

  reportData Json

  generatedAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  company Company @relation(fields:[companyId],references:[id])

  candidate Candidate @relation(fields:[candidateId],references:[id])

  assessment Assessment @relation(fields:[assessmentId],references:[id])

  attempt ExamAttempt @relation(fields:[attemptId],references:[id])
}



enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}


enum AssessmentLevel {
  ENTRY
  MID
  TOP
}

enum AssessmentStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum InvitationStatus {
  SENT
  STARTED
  COMPLETED
  EXPIRED
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum QuestionType {
  LIKERT
  FORCED_CHOICE
  SITUATIONAL_JUDGEMENT
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum CandidateStatus {
  INVITED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  WITHDRAWN
}
